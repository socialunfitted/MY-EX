{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/frontend",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/frontend/:path*",
      "destination": "/:path*"
    }
  ]
}
